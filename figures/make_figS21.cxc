style #2 stick
size #2 stickRadius 0.25
color #2 byhetero
color #2 & C #a0286e
color #2 & I #8a2be2
volume #1 style mesh color #5a5a5a sdLevel 3.5 step 1 squareMesh false meshLighting false
volume zone #1 nearAtoms #2/X5,E5,N5,j5,a6,Q4,d7,i5,F5,K6,U4,T3,D5,k5,h5,G5,S3,V4,L6,c7,C5,l5,P4,Z6,Y5,O5,H5,e4,g5,J4,B5,M5,W5,b6,m5,R4,I5,n6,A6,f5 range 2.2
